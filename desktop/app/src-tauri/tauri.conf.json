{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gamepad Mapper Pluton",
  "mainBinaryName": "gamepad-mapper-pluton",
  "version": "0.2.0",
  "identifier": "io.github.hades0413.gamepadmapperpluton",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Gamepad Mapper Plutón",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQUIyREEzRDJEODkzRTUKUldUbGs5alNveTJyUDJIc2dHaUtzRktueGF4ekt4eDVPeXViS2RYM09hU0pkY1JJYUpYMFd0MkMK",
      "endpoints": [
        "https://github.com/Hades0413/GamePadMapperPluton/releases/download/escritorio-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "createUpdaterArtifacts": false,
    "category": "Game",
    "publisher": "Hades0413",
    "copyright": "Hades0413 — PolyForm Noncommercial 1.0.0",
    "homepage": "https://github.com/Hades0413/GamePadMapperPluton",
    "shortDescription": "Mapea cualquier mando en Linux y Windows",
    "longDescription": "Gamepad Mapper Plutón para escritorio: lista los mandos conectados, muestra su entrada en vivo, asigna cada botón y eje a un mando estándar y lo convierte en un mando virtual Xbox 360, DualShock 4 o Switch Pro, con macros, turbo, capas y configuraciones por juego.",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/gamepad-mapper-pluton.desktop",
        "postInstallScript": "linux/postinst.sh",
        "files": {
          "/usr/lib/udev/rules.d/70-gamepad-mapper-pluton.rules": "linux/70-gamepad-mapper-pluton.rules"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
