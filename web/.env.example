# Copia este archivo a .env.local y rellena con los datos de tu proyecto de Supabase
# (Project Settings > API). Ambos valores son PUBLICOS: van dentro de la web.
# NUNCA pongas aqui la clave "service_role" / "secret".
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Direccion publica de la web y ruta base (GitHub Pages de proyecto)
VITE_SITE_URL=https://hades0413.github.io/GamePadMapperPluton
VITE_BASE_PATH=/GamePadMapperPluton/

# Enlaces de descarga de la app
VITE_PLAY_URL=https://play.google.com/store/apps/details?id=com.gamepadmapper.app
VITE_REPO_URL=https://github.com/Hades0413/GamePadMapperPluton
