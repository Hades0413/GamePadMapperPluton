<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gamepadmapper.app"
    android:versionCode="8"
    android:versionName="1.6">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Descargar perfiles del catalogo -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber que juego esta en primer plano (burbuja) y reactivarla al encender -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Pedir que Android no detenga el servicio por ahorro de bateria -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Modo rapido sin root con Shizuku (la app aparece en su lista de apps autorizables) -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Para listar los juegos instalados al crear un perfil -->
    <queries>
        <!-- Detectar Magisk para ofrecer el modo root -->
        <package android:name="com.topjohnwu.magisk" />
        <!-- Modo rapido sin root (Shizuku) -->
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:enableOnBackInvokedCallback="false"
        android:hasFragileUserData="true"
        android:label="Gamepad Mapper Plutón"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Recibir un perfil compartido como texto (WhatsApp, Telegram, lector de QR...) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "Abrir en la app" desde la web: gpmapper://perfil/<id>, gpmapper://juego/<paquete> y gpmapper://subido/<id> (tras publicar) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gpmapper" android:host="perfil" />
                <data android:scheme="gpmapper" android:host="juego" />
                <data android:scheme="gpmapper" android:host="subido" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Mapeador sin root: lee el mando y toca la pantalla (Ajustes > Accesibilidad) -->
        <service
            android:name=".PadService"
            android:label="@string/pad_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pad_service" />
        </service>

        <!-- Shizuku entrega aqui su conexion (modo rapido sin root) -->
        <provider
            android:name=".ShizukuClient$Provider"
            android:authorities="com.gamepadmapper.app.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <!-- Boton de Ajustes rapidos: pausar / reanudar el mando -->
        <service
            android:name=".PauseTile"
            android:exported="true"
            android:icon="@drawable/ic_gamepad"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Burbuja flotante sobre juegos para editar y cambiar perfiles del mando" />
        </service>
    </application>
</manifest>
