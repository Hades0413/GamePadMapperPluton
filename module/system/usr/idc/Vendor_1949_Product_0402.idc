# GamepadPlus V3 (Seisa SJA-1006) en modo Home+A
# Pantalla tactil asociada a la pantalla del telefono.
# El mando envia coordenadas en la orientacion en que se ve la pantalla,
# por eso orientationAware = 0 (no asumir panel fijo en vertical).
device.internal = 1
touch.deviceType = touchScreen
touch.orientationAware = 0
