# Finales de linea fijos para todos los sistemas (Linux, macOS, Windows):
# en el repositorio todo el texto va con LF; cada archivo se entrega como lo necesita.
* text=auto eol=lf

# Scripts de Windows: CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Lo que leen Android/Magisk o bash: siempre LF (un CRLF los rompe)
*.sh            text eol=lf
Makefile        text eol=lf
*.prop          text eol=lf
*.idc           text eol=lf
*.conf          text eol=lf
update-binary   text eol=lf
updater-script  text eol=lf

# Binarios: nunca convertir
*.png  binary
*.jpg  binary
*.jks  binary
*.apk  binary
*.aab  binary
*.zip  binary
*.jar  binary
gpmapper binary
